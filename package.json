{
  "name": "kareem-marefa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build -w @kareem/storage-paths && npm run build -w @kareem/designer-runtime && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:e2e:unconfigured": "node scripts/e2e-unconfigured.mjs",
    "test:rls": "RLS_DATABASE_URL=${RLS_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres} node scripts/rls.mjs",
    "policy-diff": "node scripts/policy-diff.mjs",
    "serve:stub": "node scripts/serve-stub.mjs",
    "qa": "node scripts/qa-run.mjs",
    "visual": "node scripts/visual-diff.mjs",
    "parity": "node scripts/parity/harness.mjs",
    "parity:update": "node scripts/parity/harness.mjs --update",
    "fonts:extract": "node scripts/fonts/extract.mjs",
    "fonts:derive": "python3 scripts/fonts/derive-ttf.py",
    "fonts:check": "node scripts/fonts/check.mjs",
    "worker:build": "npm run build -w @kareem/worker",
    "worker:probe": "npm run probe -w @kareem/worker",
    "worker:start": "npm run start -w @kareem/worker",
    "lockfile": "node scripts/lockfile.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "prepare": "npm run build -w @kareem/storage-paths && npm run build -w @kareem/designer-runtime"
  },
  "dependencies": {
    "@kareem/fonts": "0.1.0",
    "@kareem/storage-paths": "0.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.110.2",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^30.0.1",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
