# Supabase — Settings → API. Use the PUBLISHABLE key (sb_publishable_...),
# never the secret key. It operates as `anon` under RLS (insert-only).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# HMAC secret for the form's min-time-to-submit token. Generate with:
#   openssl rand -hex 32
FORM_TOKEN_SECRET=

# Optional: canonical site URL for OG metadata (set on Vercel in production).
SITE_URL="https://kareem.pp.sa"

# ── The platform (M1+). DEC-020 / DEC-021: the browser client needs these two
# for auth UI and Realtime; RLS is the boundary. Locally: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Launch (DEC-058). Vercel Production/Preview — the app.
# Generate once and keep stable across deploys (04 §9.2): openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Google Cloud → Credentials → the OAuth client; redirect URI <SITE_URL>/api/calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Launch (DEC-058). Railway — the worker only. NEVER on Vercel (invariant 7).
# Session-mode connection on port 5432 (the boot probe refuses the 6543 pooler).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API Keys → Secret keys (or the legacy service_role JWT).
SUPABASE_SERVICE_ROLE_KEY=
# The QR targets on posters and certificates.
PUBLIC_ORIGIN=https://kareem.pp.sa
# `resend` is the only value that reaches a provider; anything else is a sink (DEC-046).
MAIL_TRANSPORT=resend
# Resend → API Keys, sending access, restricted to the verified domain.
RESEND_API_KEY=
# Optional; defaults to no-reply@kareem.pp.sa (08 §3.4).
MAIL_FROM_ADDRESS=
# The same Google client — the worker refreshes calendar tokens with it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The container runs as `node` without user namespaces; CI sets the same.
CHROME_NO_SANDBOX=1
