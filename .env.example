# Supabase — Settings → API. Use the PUBLISHABLE key (sb_publishable_...),
# never the secret key. It operates as `anon` under RLS (insert-only).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# HMAC secret for the form's min-time-to-submit token. Generate with:
#   openssl rand -hex 32
FORM_TOKEN_SECRET=

# Optional: canonical site URL for OG metadata (set on Vercel in production).
SITE_URL=

# ── The platform (M1+). DEC-020 / DEC-021: the browser client needs these two
# for auth UI and Realtime; RLS is the boundary. Locally: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
